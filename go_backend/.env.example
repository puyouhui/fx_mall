APP_PORT=8082

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=fx_app
DB_PASSWORD=replace_with_local_password
DB_NAME=fx_shop
DB_CHARSET=utf8mb4

# 本地对象存储（与 docker-compose.local.yml 保持一致）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=zhujiang_local
MINIO_SECRET_KEY=replace_with_local_secret
MINIO_BUCKET=zhujiang
MINIO_USE_SSL=false
MINIO_BASE_URL=http://127.0.0.1:8082/minio
MINIO_PUBLIC_READ=true

# 可选：本地调试小程序登录、地图功能时填写
# MINI_APP_ID=
# MINI_APP_SECRET=
# AMAP_KEY=
# TENCENT_MAP_KEY=
